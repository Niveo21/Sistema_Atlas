# Copia este archivo a .env y completa los valores. NUNCA subas .env a Git.
PORT=4000
DATABASE_URL=postgres://atlas:cambiar_esta_clave@localhost:5432/atlas
# Secreto para firmar JWT: usa al menos 64 caracteres aleatorios.
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=15m
# Origen permitido para el frontend (CORS).
CORS_ORIGIN=http://localhost:3000
BCRYPT_ROUNDS=12
# Carpeta interna donde se guardan los documentos (fuera del código fuente).
STORAGE_DIR=./storage
# Tamaño máximo por archivo en MB.
MAX_UPLOAD_MB=10
